<?xml version="1.0" encoding="UTF-8"?>
<xjb:bindings xmlns:annox="urn:jaxb.jvnet.org:annox" jaxb:extensionBindingPrefixes="xjc annox" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" xmlns:xjb="https://jakarta.ee/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="3.0" xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc" xmlns:pm="http://standards.ieee.org/downloads/11073/11073-10207-2017/participant">
	<xjb:bindings schemaLocation="BICEPS_ParticipantModel.xsd">
	    <!-- Make JAXB using Java 8 state of the art date-time objects -->
        <xjb:globalBindings>
            <xjc:javaType name="java.time.LocalDate" xmlType="xs:date" adapter="io.github.threetenjaxb.core.LocalDateXmlAdapter" />
            <xjc:javaType name="org.somda.sdc.common.model.AnyDateTime" xmlType="xs:dateTime" adapter="org.somda.sdc.common.model.AnyDateTimeAdapter" />
            <xjc:javaType name="java.time.Duration" xmlType="xs:duration" adapter="org.somda.sdc.common.model.DurationAdapter" />
			<xjc:javaType name="java.time.Instant" xmlType="pm:Timestamp" adapter="org.somda.sdc.common.model.TimestampAdapter" />
        </xjb:globalBindings>

		<!-- Put Participant Model elements to package org.somda.sdc.biceps.model.participant. -->
		<xjb:schemaBindings>
			<xjb:package name="org.somda.sdc.biceps.model.participant"/>
		</xjb:schemaBindings>

		<!-- Customized type-safe bindings for anonymous enums -->
		<xjb:bindings node="//xs:complexType[@name='InstanceIdentifier']/xs:attribute[@name='Root']">
			<xjb:property name="rootName"/>
		</xjb:bindings>
		<xjb:bindings node="//xs:complexType[@name='InstanceIdentifier']/xs:attribute[@name='Extension']">
			<xjb:property name="extensionName"/>
		</xjb:bindings>
		<xjb:bindings node="//xs:complexType[@name='AbstractMetricDescriptor']//xs:attribute[@name='Kind']/xs:simpleType">
			<xjb:typesafeEnumClass name="Kind" />
		</xjb:bindings>
		<xjb:bindings node="//xs:complexType[@name='AbstractOperationDescriptor']//xs:attribute[@name='AccessLevel']/xs:simpleType">
			<xjb:typesafeEnumClass name="AccessLevel" />
		</xjb:bindings>
		<xjb:bindings node="//xs:complexType[@name='BatteryState']//xs:attribute[@name='ChargeStatus']/xs:simpleType">
			<xjb:typesafeEnumClass name="ChargeStatus" />
		</xjb:bindings>
		<xjb:bindings node="//xs:complexType[@name='ClinicalInfo']//xs:element[@name='Criticality']/xs:simpleType">
			<xjb:typesafeEnumClass name="Criticality" />
		</xjb:bindings>
		<!-- elements with unbounded occurrences have a getter which returns an empty list -->
		<xjb:bindings multiple="true" node="//xs:element[@minOccurs='0' and @maxOccurs='unbounded']">
			<annox:annotate target="setter-parameter">@org.jetbrains.annotations.Nullable</annox:annotate>
		</xjb:bindings>
		<!-- elements with zero or one occurrences -->
		<xjb:bindings multiple="true" node="//xs:element[@minOccurs='0' and (@maxOccurs='1' or not(@maxOccurs))]">
			<annox:annotate target="getter">@org.jetbrains.annotations.Nullable</annox:annotate>
			<annox:annotate target="setter-parameter">@org.jetbrains.annotations.Nullable</annox:annotate>
		</xjb:bindings>
		<xjb:bindings multiple="true" node="//xs:attribute[@use='optional' or not(@use)]">
			<annox:annotate target="getter">@org.jetbrains.annotations.Nullable</annox:annotate>
			<annox:annotate target="setter-parameter">@org.jetbrains.annotations.Nullable</annox:annotate>
		</xjb:bindings>
	</xjb:bindings>
</xjb:bindings>